Package: pmostraitcode
Type: Project
Title: Statistical Analysis Code for PMOS-Relevant Trait Operationalization
Version: 2.0.0
Authors@R: c(
    person("Xiaoxin", "Wu", role = c("aut", "cre")),
    person("Lirong", "Liu", role = "aut"),
    person("Yuanying", "Chen", role = "aut"),
    person("Huadong", "Liang", role = "aut")
